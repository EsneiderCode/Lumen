# Real Supabase backend — ask Alejandro for the project's URL and anon key.
# Copy this file to .env.development and fill in the values.
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase Edge Function secrets (set in Supabase, never with VITE_*).
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# Demo mode — see .env.demo (no credentials needed). Run with `npm run dev:demo`.
# VITE_DEMO=true

# Map tiles (trench map). By default BOTH are derived from VITE_SUPABASE_URL:
# the basemap is a PMTiles archive we host ourselves, in the public 'basemap'
# bucket of the same project. Build and publish it with:
#
#   SUPABASE_URL=… SUPABASE_SERVICE_ROLE_KEY=… ./scripts/build-basemap.sh
#
# Set these two only to move to another provider. The style in
# src/lib/mapStyle.ts is written against the Protomaps basemaps v4 schema, so an
# OpenMapTiles endpoint (OpenFreeMap, MapTiler) renders an EMPTY map until that
# file is remapped. Glyphs must match the provider.
# VITE_MAP_TILES_URL=pmtiles://https://<ref>.supabase.co/storage/v1/object/public/basemap/de-zonas.pmtiles
# VITE_MAP_GLYPHS_URL=https://<ref>.supabase.co/storage/v1/object/public/basemap/fonts/{fontstack}/{range}.pbf
