# Real Supabase backend — ask Alejandro for the project's URL and anon key.
# Copy this file to .env.development and fill in the values.
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase Edge Function secrets (set in Supabase, never with VITE_*).
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# Demo mode — see .env.demo (no credentials needed). Run with `npm run dev:demo`.
# VITE_DEMO=true

# Map tiles (trench map). Defaults to OpenFreeMap: free, no account, no key,
# commercial use allowed, OpenStreetMap data. Override only to move to another
# provider — any TileJSON endpoint in the OpenMapTiles schema works (MapTiler,
# a self-hosted Protomaps/pmtiles server…). Glyphs must match the provider.
# VITE_MAP_TILES_URL=https://tiles.openfreemap.org/planet
# VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
