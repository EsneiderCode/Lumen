# Demo mode — Supabase calls go to an in-memory mock with seeded fixtures.
# No real backend, no credentials required. Used by `npm run dev:demo`.

VITE_DEMO=true

# These are unused in demo mode but Vite needs the keys present.
VITE_SUPABASE_URL=demo://offline
VITE_SUPABASE_ANON_KEY=demo-mode-no-real-key

# The basemap has no mock: it is a real file in a PUBLIC storage bucket (no key,
# no session), so demo mode reads the same one production does. Spelled out here
# because VITE_SUPABASE_URL above is not a real host to derive it from.
VITE_MAP_TILES_URL=pmtiles://https://zucmrnuwceugsibndxvc.supabase.co/storage/v1/object/public/basemap/de-zonas.pmtiles
VITE_MAP_GLYPHS_URL=https://zucmrnuwceugsibndxvc.supabase.co/storage/v1/object/public/basemap/fonts/{fontstack}/{range}.pbf
